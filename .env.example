# Documentation template only; the bridge does not load dotenv automatically.
# Inject values through a private process environment/secret manager.
# Never commit a populated copy. Empty entries are not usable credentials.
OPENAI_API_KEY=
OPENAI_EXECUTOR_API_KEY=
# Alternative to OPENAI_EXECUTOR_API_KEY:
CODEX_API_KEY=
# Used by standalone metadata lookup; not forwarded by tunnel.py:
CONTROL_PLANE_API_KEY=
# Normally supplied by tunnel.py from private personal-tunnel.json:
BRIDGE_TUNNEL_ID=
# Optional standalone Codex executable; default is $HOME/.local/bin/codex.
CODEX_BINARY=
# Direct controller launch only; managed helper uses an existing gh login instead:
GH_TOKEN=
GITHUB_TOKEN=
